menu "IKEA Vindriktning Configuration"

    config UART_PORT_NUM
        int "UART port number"
        range 0 2 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32S3
        default 2 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32S3
        range 0 1 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32H2
        default 1 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32H2
        range 0 1
        default 1
        help
            UART communication port number.
            See UART documentation for available port numbers.

    config UART_BAUD_RATE
        int "UART communication speed"
        range 1200 115200
        default 9600
        help
            UART communication speed.

    config UART_RXD
        int "UART RXD pin number"
        default 20
        help
            GPIO number for UART RX pin. See UART documentation for more information
            about available pin numbers for UART.

    menu "Wi-Fi"
        config WIFI_SSID
            string "SSID"
            default ""
            help
                Name of the Wi-Fi network to connect to.

        config WIFI_PASSWORD
            string "Password"
            default ""
            help
                Password of the Wi-Fi network. Leave empty for an open network.
    endmenu

    menu "Multicast"
        config MULTICAST_SOURCE
            string "Device name"
            default "vindriktning"
            help
                Name sent in every message, so receivers can tell devices apart.

        config MULTICAST_GROUP
            string "Air quality multicast group"
            default "239.255.10.1"
            help
                IPv4 multicast group that air quality messages are sent to.
                Receivers join this group to get them.

        config MULTICAST_PORT
            int "UDP port"
            range 1 65535
            default 45000
            help
                UDP port that messages are sent to.

        config MULTICAST_TTL
            int "TTL"
            range 1 255
            default 1
            help
                Number of routers messages may pass. 1 keeps them on the local network.
    endmenu

endmenu
